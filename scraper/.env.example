HLTV_PROXY_URL=http://username:password@gate.decodo.com:7000
HLTV_PROXY_REGIONS=us,eu,br
HLTV_RAW_DIR=data/raw/hltv
HLTV_OUTPUT_DIR=data/hltv_scraped
HLTV_DB_PATH=data/hltv_scraper.db
HLTV_DAILY_CAP=100
HLTV_MIN_DELAY=8
HLTV_MAX_DELAY=15
HLTV_COOLDOWN_EVERY=50
HLTV_COOLDOWN_SECONDS=120
HLTV_QUIET_HOURS_START=3
HLTV_QUIET_HOURS_END=6
HLTV_VERIFY_TLS=true
# Number of curl_cffi attempts (rotating proxy IP + browser fingerprint) before
# giving up / falling back. HLTV's edge blocks intermittently, so retrying helps.
HLTV_CURL_ATTEMPTS=4
# Headless Playwright cannot solve HLTV's Cloudflare managed challenge, so it is
# only useful where a real/headed browser is available. Set false to skip it.
HLTV_USE_PLAYWRIGHT=true
HLTV_EVENT_ALLOW_LIST=PGL Major,BLAST.tv Major,IEM,Intel Extreme Masters,ESL Pro League,BLAST Premier,CS Asia Championships,CCT,YaLLa,Roobet
HLTV_EVENT_TIER_OVERRIDES=PGL Major=1,BLAST.tv Major=1,IEM Katowice=1,IEM Cologne=1,ESL Pro League=1,BLAST Premier World Final=1,CS Asia Championships=1,CCT=2,YaLLa Compass=2,Roobet Cup=2
HLTV_BACKFILL_PAGES_PER_RUN=50
HLTV_BACKFILL_MATCHES_PER_RUN=100
HLTV_BACKFILL_EMPTY_PAGES_TO_STOP=10
HLTV_BACKFILL_START_PAGE=0
HLTV_BACKFILL_MAX_PAGE=
HLTV_BACKFILL_STOP_DATE=2023-09-27
HLTV_TIER_REGISTRY_PATH=tier_registry.yaml
HLTV_ALERT_WEBHOOK_URL=
# Decodo Site Unblocker — only needed for `enrich-stats` (detailed /stats/ data:
# opening duels, multi-kills, clutches, HS kills, flash assists). Leave blank to disable.
HLTV_UNBLOCKER_PROXY=https://unblock.decodo.com:60000
HLTV_UNBLOCKER_USER=
HLTV_UNBLOCKER_PASS=
